		"@mui/x-data-grid": "^9.14.0",
		"@tanstack/react-query": "^5.103.2",
		"@xyflow/react": "^12.11.6",
		"axios": "^1.20.0",
		"immer": "^11.1.18",
		"inversify": "^8.2.3",
		"jwt-decode": "^4.0.0",
