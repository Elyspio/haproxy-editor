<Project Sdk="Aspire.AppHost.Sdk/13.5.4">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<UserSecretsId>14e7c697-3122-416f-8a7f-fb1ae2b5171b</UserSecretsId>
		<!-- DCP and the dashboard keep coming from NuGet so `dotnet run` and IDE launches work without the Aspire CLI bundle. -->
		<AspireUseCliBundle>false</AspireUseCliBundle>
		<NoWarn>$(NoWarn);ASPIRE010</NoWarn>
	</PropertyGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Haproxy.Editor.Api\Haproxy.Editor.WebApi\Haproxy.Editor.WebApi.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="Aspire.Hosting.JavaScript" Version="13.5.4" />
	  <PackageReference Include="Aspire.Hosting.Keycloak" Version="13.5.4-preview.1.26464.4" />
	  <PackageReference Include="Aspire.Hosting.MongoDB" Version="13.5.4" />
	</ItemGroup>

	<ItemGroup>
	  <None Update="appsettings.Development.json">
	    <DependentUpon>appsettings.json</DependentUpon>
	  </None>
	</ItemGroup>

</Project>
